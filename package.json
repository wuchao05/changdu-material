{
  "name": "changdu-material",
  "version": "2.0.0",
  "description": "常读短剧素材上传下载管理工具",
  "main": "./out/main/index.js",
  "author": "GuaZai",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "preinstall": "node scripts/check-package-manager.js",
    "postinstall": "electron-builder install-app-deps",
    "install:electron": "node scripts/install-electron.js",
    "juliang:login-state": "node scripts/juliang-login-state.js",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "type-check": "vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test:allocation": "node scripts/test-material-allocation.mjs"
  },
  "dependencies": {
    "@chinese-fonts/maple-mono-cn": "2.0.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource/maple-mono": "5.2.6",
    "@playwright/browser-chromium": "^1.58.2",
    "@vicons/ionicons5": "^0.12.0",
    "@volcengine/tos-sdk": "^2.9.0",
    "axios": "^1.7.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.11",
    "electron-dl": "^4.0.0",
    "electron-store": "^8.2.0",
    "extract-zip": "^2.0.1",
    "form-data": "^4.0.5",
    "js-yaml": "^4.1.1",
    "naive-ui": "^2.39.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "playwright": "^1.58.2",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^10.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.9",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "cross-env": "^10.1.0",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.3.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.0.26"
  }
}
